#!/bin/sh
# Enable gsd-rfkill and install its udev rule. Re-runs when the rendered
# content below changes (unit, target, or rule).
#
# unit hash:   {{ include "private_dot_config/systemd/user/gsd-rfkill.service" | sha256sum }}
# target hash: {{ include "private_dot_config/systemd/user/i3-session.target" | sha256sum }}
set -eu

# --- user units (no privileges needed) -------------------------------------
systemctl --user daemon-reload
# drop stale enablement from older unit revisions, then enable per [Install]
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/default.target.wants/gsd-rfkill.service"
systemctl --user reenable gsd-rfkill.service

# --- system udev rule (needs root) -----------------------------------------
# restart gsd-rfkill on rfkill hotplug, so its view stays fresh post-login
RULE_FILE=/etc/udev/rules.d/90-gsd-rfkill-restart.rules
RULE='ACTION=="add", SUBSYSTEM=="rfkill", RUN+="/usr/bin/systemctl --user --machine={{ .chezmoi.username }}@.host --no-block restart gsd-rfkill.service"'

# only escalate when the rule actually changed (avoids a needless sudo prompt)
if [ "$(cat "$RULE_FILE" 2>/dev/null || true)" != "$RULE" ]; then
    printf '%s\n' "$RULE" | sudo tee "$RULE_FILE" >/dev/null
    sudo udevadm control --reload
fi
